<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 唯一識別名稱 -->
    <key>Label</key>
    <string>com.yuanta.review-crawler-agent</string>

    <!-- 執行指令：使用 venv 中的 Python 直接執行 agent，
         setup_launchagent.sh 會自動替換下方的 AGENT_DIR 佔位符 -->
    <key>ProgramArguments</key>
    <array>
        <string>AGENT_DIR/.venv/bin/python3</string>
        <string>AGENT_DIR/scraper_agent.py</string>
        <string>--run-now</string>
        <string>--deploy</string>
    </array>

    <!-- 排程：每週一 09:00（台北時間；LaunchAgent 使用本機時間） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>  <!-- 1 = 週一 -->
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- 標準輸出 & 錯誤輸出寫入 log -->
    <key>StandardOutPath</key>
    <string>AGENT_DIR/launchagent_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>AGENT_DIR/launchagent_stderr.log</string>

    <!-- 工作目錄 -->
    <key>WorkingDirectory</key>
    <string>AGENT_DIR</string>

    <!-- 環境變數 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>zh_TW.UTF-8</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 如果上次未執行（例如電腦關機），開機後立即補執行 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
